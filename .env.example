# WangOJ 后端环境变量示例
# 复制为 .env（不要提交）或直接导出到 shell / 容器环境变量中

# ---------- 数据库 ----------
# 本地开发（直接用宿主机 MySQL）
# 注意：docker compose 场景下 DB_USERNAME 会作为 MySQL 业务账号被创建，不要填 root
DB_URL=jdbc:mysql://localhost:3306/wangoj?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=wangoj
# 业务账号密码：必须替换为随机长字符串（>=12 字符）；保留 __REQUIRED__ 或使用 change-me 会导致后端启动失败
DB_PASSWORD=__REQUIRED__
# 数据库口令启动校验开关，默认 true；仅在不需要连库的场景才设为 false
APP_DB_VALIDATE_PASSWORD=true
DB_POOL_SIZE=10
# docker compose 使用：数据库名与 root 密码（DB_URL 由 compose 自动拼装，无需手改）
DB_NAME=wangoj
DB_ROOT_PASSWORD=__REQUIRED__

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# 必填：保留 __REQUIRED__ 时 docker compose 会直接拒绝启动
REDIS_PASSWORD=__REQUIRED__

# ---------- 服务 ----------
SERVER_PORT=8123

# ---------- 安全 ----------
# 允许跨域的前端来源，多个用逗号分隔；生产环境务必改成真实域名
APP_CORS_ORIGINS=http://localhost:5173
# 密码哈希盐值：必须设置成随机长字符串（>=16 字符），且上线后不要再修改（修改会导致已有用户无法登录）
# 保留 __REQUIRED__ 会导致后端启动失败
APP_PASSWORD_SALT=__REQUIRED__

# ---------- 判题沙箱 ----------
# 沙箱只应在私有网络中可访问，不要暴露到公网；前端与浏览器永远不直接访问它
# 协议：JSON + X-Judge-Token
JUDGE_URL=http://localhost:8122/api/v1/judge
# 后端与沙箱共享的鉴权令牌，两边必须一致；未设置或保留 __REQUIRED__ 时判题会被拒绝（fail-closed）
# 生成方式：openssl rand -hex 32
JUDGE_TOKEN=__REQUIRED__
JUDGE_CONNECT_TIMEOUT_MS=2000
# 建议 >= 编译时间 + 题目时间限制 × 测试点数 + 5s
JUDGE_READ_TIMEOUT_MS=60000
# 沙箱自身监听端口（与上面 JUDGE_URL 的端口保持一致）
JUDGE_PORT=8122
JUDGE_LOG_LEVEL=info
# 判题工作目录，仅 docker compose 使用。
# 必须同时是「judge 容器内可写」与「宿主 Docker daemon 可见」的同一路径，
# 否则判题容器按宿主机路径挂载会拿到空目录，编译阶段报 /data/main.c 不存在。
# compose 已用同源同目标的 bind mount 保证这一点，通常无需修改。
JUDGE_SOURCE_DIR=/var/lib/wangoj/source

# ---------- AI（可选） ----------
# 关闭时不会发起任何外部请求，前端 AI 功能会返回“本站未启用 AI 功能”
APP_AI_ENABLED=false
# OpenAI 兼容接口地址（可带或不带 /v1）
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=60000
AI_MAX_CODE_LENGTH=65536
# 单个用户每分钟最多调用 AI 接口的次数（0 表示不限制）
APP_AI_RATE_LIMIT_PER_MINUTE=10

# ---------- 登录与缓存 ----------
# 同一账号在锁定期内允许的最大失败次数，超过后锁定 APP_LOGIN_LOCK_SECONDS 秒
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_LOCK_SECONDS=300
# 登录 Token 有效期（分钟），每次请求滑动续期；改密/降权/删号会立即吊销
APP_TOKEN_TIMEOUT_MINUTES=10
# 题目详情缓存（小时）与排行榜缓存（分钟）
APP_PROBLEM_CACHE_HOURS=12
APP_RANK_CACHE_MINUTES=5

# ---------- 其他 ----------
# 生产环境建议关闭 API 文档
KNIFE4J_ENABLE=true
# 可选值：health,info 或 *（不推荐对外暴露 *）
ACTUATOR_ENDPOINTS=health,info
LOG_LEVEL=info
